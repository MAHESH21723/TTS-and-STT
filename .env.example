# Copy to .env and adjust. .env is gitignored.

# Secret used to sign the session cookie. If empty, a random key is generated
# on every start (fine for local use; sessions reset on restart).
SECRET_KEY=

# Set to 1 to enable Flask debug mode (local development only).
FLASK_DEBUG=0

# Interface and port for `python app.py`. Defaults bind to localhost only.
HOST=127.0.0.1
PORT=5000

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=16
